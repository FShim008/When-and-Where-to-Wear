# ---- Unity generated (regenerable cache — never commit) ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files must be kept even when other ignores are broad
!/[Aa]ssets/**/*.meta

# ---- IDE / build tool files (regenerated by Unity) ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Build / packaging artifacts ----
*.apk
*.aab
*.app
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Auto-generated Android streaming assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Project-specific artifacts ----
UpgradeLog.htm
TestResults*.xml

# ---- Reference PDFs: NEVER commit to a public repo ----
# Publisher copies (IEEE, Taylor & Francis) may not be redistributed, and this remote is public.
# Keep them locally; cite by DOI in the docs instead.
#   Valkov & Linsen 2019   10.1109/vr.2019.8798036
#   Meng et al. 2014       10.1080/00140139.2014.976278
*.pdf
